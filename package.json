{
  "name": "aq-apply-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent that scores your resumes against every AfterQuery job and applies for you.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "extract-ops": "tsx tools/extract-ashby-ops.ts",
    "postinstall": "playwright install chromium || true",
    "selftest": "tsx tools/selftest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "express": "^5.1.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "openai": "^7.9.0",
    "playwright": "^1.62.1",
    "unpdf": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.3",
    "graphql": "^17.0.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
