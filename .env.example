# ---------------------------------------------------------------------------
# LLM key. Either provider works; whichever key is present is used (OpenAI
# first). Without one the agent still runs, but match scores fall back to a
# keyword heuristic and unexpected application questions cannot be answered.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Force a provider instead of auto-detecting: openai | anthropic | auto
AQ_LLM_PROVIDER=auto

# Model override. Leave blank to use the provider default
# (OpenAI: gpt-5, Anthropic: claude-opus-5). If the default is not available to
# your key, the server prints the models your key CAN use on startup.
AQ_MODEL=

# Default OpenAI reasoning effort: minimal | low | medium | high.
# Scoring uses low (it runs ~80 times); profile extraction and form answers use
# medium regardless, because those get written onto a real application.
AQ_EFFORT=low

# Roles given a real LLM assessment per resume; the rest keep their heuristic
# score and are labelled as such. 0 = assess all ~206. At ~20s per call this is
# the main time/cost dial.
AQ_SCORE_LIMIT=80

# Parallel LLM calls while scoring.
AQ_SCORE_CONCURRENCY=6

# SAFETY VALVE.
#   1 = fill, validate and report every application, but never submit it.
#   0 = submit for real to AfterQuery's ATS.
# Ships as 1 so a fresh copy cannot file an application by accident. Flip to 0
# once you have watched a dry run and are happy with the answers it produced.
AQ_DRY_RUN=1

# Parallel browser workers during a bulk apply. 2 is a polite, reliable default.
AQ_APPLY_CONCURRENCY=2

# 1 = show the Chrome window while applying (useful to watch a failure happen).
AQ_HEADFUL=0

# ---------------------------------------------------------------------------
# AfterQuery Experts board (~173 contract roles). All of them are public, so
# this works signed out; signing in only lets the agent fetch them as you.
#
# NOTE: being logged in in your OWN browser cannot be detected. A page served
# from localhost is not allowed to read experts.afterquery.com's session - that
# is the same-origin policy, not a limitation of this agent. Pick one of the two
# routes below.
# ---------------------------------------------------------------------------
AQ_EXPERTS=1

# Route 1 (default): the agent keeps its own browser profile and you sign in
# there once, via the Sign in button in the UI.
#   Browser used for that window. Blank auto-detects real Chrome, then Edge,
#   then bundled Chromium. Google often refuses OAuth from bundled Chromium,
#   so a real browser matters here.
AQ_BROWSER_CHANNEL=
#   How long the sign-in window waits for you, in ms.
AQ_SIGNIN_TIMEOUT_MS=300000

# Route 2: attach to the Chrome you are ALREADY signed into. Start Chrome with
#   chrome --remote-debugging-port=9222
# then set this. No separate sign-in needed.
AQ_CHROME_CDP=

PORT=5173
