# ---------------------------------------------------------------------------
# LLM key. Either provider works; whichever key is present is used (OpenAI
# first). Without one the agent still runs, but match scores fall back to a
# keyword heuristic and unexpected application questions cannot be answered.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Force a provider instead of auto-detecting: openai | anthropic | auto
AQ_LLM_PROVIDER=auto

# Model override. Leave blank to use the provider default
# (OpenAI: gpt-5, Anthropic: claude-opus-5). If the default is not available to
# your key, the server prints the models your key CAN use on startup.
AQ_MODEL=

# Default OpenAI reasoning effort: minimal | low | medium | high.
# Scoring uses low (it runs ~80 times); profile extraction and form answers use
# medium regardless, because those get written onto a real application.
AQ_EFFORT=low

# Roles given a real LLM assessment per resume; the rest keep their heuristic
# score and are labelled as such. 0 = assess all ~206. At ~20s per call this is
# the main time/cost dial.
AQ_SCORE_LIMIT=80

# Parallel LLM calls while scoring.
AQ_SCORE_CONCURRENCY=6

# SAFETY VALVE.
#   1 = fill, validate and report every application, but never submit it.
#   0 = submit for real to AfterQuery's ATS.
# Ships as 1 so a fresh copy cannot file an application by accident. Flip to 0
# once you have watched a dry run and are happy with the answers it produced.
AQ_DRY_RUN=1

# Parallel workers during a bulk apply (Experts only). Ashby always runs one at
# a time with a human-paced gap, because many submissions to one company in
# minutes get flagged as spam regardless of the reCAPTCHA token.
AQ_APPLY_CONCURRENCY=2
# Gap between consecutive Ashby submissions in a bulk run, ms (randomised +/-30%).
AQ_ASHBY_GAP_MS=75000

# 1 = show the Chrome window while applying (useful to watch a failure happen).
AQ_HEADFUL=0

# ---------------------------------------------------------------------------
# AfterQuery Experts board (~173 contract roles). All of them are PUBLIC, so this
# works signed out; signing in only lets the agent fetch them as you.
#
# WHY YOUR EXISTING LOGIN ISN'T SEEN AUTOMATICALLY: a page served from localhost
# cannot read experts.afterquery.com's session (same-origin policy), and the
# on-disk session is compressed LevelDB that only decodes through a browser
# engine. So pick ONE of the three routes below. The UI has buttons for all of
# them; these env vars just set defaults.
# ---------------------------------------------------------------------------
AQ_EXPERTS=1

# Route 0 - RECOMMENDED, fully headless. Once a refresh token is captured (via
# any route below, or pasted in the UI), the agent mints fresh ID tokens forever
# from Google's secure-token endpoint - no browser, survives restarts, lasts
# weeks. This key is AfterQuery's public Firebase Web API key; blank uses the
# built-in default.
AQ_FIREBASE_API_KEY=

# "How did you hear about this?" sent with Experts applications.
AQ_JOB_SOURCE=AfterQuery

# Route 1 - "Use my Chrome" (reuses your existing Google login):
# the agent reopens your real Chrome profile with a debug port and reads the
# live session - nothing is copied. You must fully quit Chrome first, because
# Chrome only opens its debug port at startup. Usually driven by the UI button.
AQ_USE_MY_CHROME=0
#   Which profile holds your login (e.g. Default, "Profile 1"); blank auto-picks.
AQ_CHROME_PROFILE=
#   chrome.exe path / Chrome "User Data" root, if non-standard; blank auto-detects.
AQ_CHROME_PATH=
AQ_CHROME_USER_DATA_DIR=
#   Debug port the agent opens on your Chrome.
AQ_CDP_PORT=9222

# Route 2 - attach to a Chrome you started yourself with a debug port:
#   chrome --remote-debugging-port=9222
# then set this. Takes precedence over Route 1.
AQ_CHROME_CDP=

# Route 3 - separate sign-in (default): the agent keeps its own browser profile
# and you sign in once via the Sign in button. Nothing to set here except,
# optionally, which browser opens for it and how long it waits.
AQ_BROWSER_CHANNEL=
AQ_SIGNIN_TIMEOUT_MS=300000

PORT=5173
